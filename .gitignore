# Rust build artifacts (workspace and isolated CI-only research crates)
/target/
**/target/
*.rs.bk

# Local development state and editor caches
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary outputs
*.log
*.tmp
*.bak
*.orig

# Never accidentally stage local runtime secrets or generated private keys.
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
*.pem

# Preserve Cargo.lock files and committed TOML templates.

# Generated Python test / tooling state (never source)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.venv/
venv/

# Local Rust instrumentation profiles
*.profraw
*.profdata

# Local driver builds and restored WDK dependencies
/drivers/windows/packages/
/drivers/linux/vmlinux.h
/drivers/linux/*.bpf.o
/f15-build-evidence/
