# Optional disposable-host acceptance fixture. Do not enable automatically.
# Install only with the reviewed Theia binary and protected active journal.
[Unit]
Description=Theia fail-closed host guard (explicit laboratory opt-in)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/theia/guard/host.toml

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/theia client linux --host-guard-rearm --confirm-disposable-host
RemainAfterExit=yes
TimeoutStartSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
RequiredBy=network-pre.target
